ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

SQLITE_DB_PATH=/app/data/notebook.db
CHROMA_DB_PATH=/app/data/chroma

OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_API_KEY=granite-local-bypass

LLM_MODEL_NAME=granite-4.0-h-tiny-UD-Q4_K_XL.gguf
EMBEDDING_MODEL_NAME=granite-embedding-107m-multilingual-Q8_0.gguf

EMBEDDING_DIMENSIONS=384
LLM_CONTEXT_WINDOW=8192
LLM_MAX_OUTPUT_TOKENS=2500
RAG_TOP_K_CHUNKS=4

CHUNK_SIZE=400
CHUNK_OVERLAP=50

LLM_TEMPERATURE=0.10
LLM_TOP_P=0.90
LLM_REPEAT_PENALTY=1.10
LLM_REQUEST_TIMEOUT=120.0
